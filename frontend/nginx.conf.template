# Nginx configuration for serving the built Aurelia SPA and reverse-proxying
# API calls to the Spring Boot backend inside the docker-compose / k8s network.
#
# This file is an nginx envsubst *template* (see Dockerfile): at container
# startup, nginx's built-in docker-entrypoint script substitutes
# ${BACKEND_UPSTREAM} with the value of the BACKEND_UPSTREAM environment
# variable and writes the result to /etc/nginx/conf.d/default.conf. It
# defaults to the docker-compose service name "backend:8080" per
# API_CONTRACT.md, and can be overridden per-environment, e.g.:
#   docker run -e BACKEND_UPSTREAM=backend:8080 ...
# nginx's own request variables ($host, $remote_addr, $scheme, $uri, ...) are
# left untouched by envsubst because they are not set as container env vars.

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # ---- Security headers ----
    # Prevents MIME-type sniffing.
    add_header X-Content-Type-Options "nosniff" always;
    # Blocks the site from being framed (clickjacking protection).
    add_header X-Frame-Options "DENY" always;
    # Limits how much referrer information is leaked cross-origin.
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Restricts script/style/image/connect sources. Google Fonts are used for
    # typography, Unsplash for illustrative product/category imagery, and
    # 'self' covers the same-origin /api reverse proxy below.
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://images.unsplash.com; connect-src 'self'; object-src 'none'; form-action 'self'" always;
    # Disables legacy browser XSS filter quirks (superseded by CSP, kept for older UAs).
    add_header X-XSS-Protection "1; mode=block" always;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Static assets: long-lived caching, filenames are content-hashed by Vite.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Reverse proxy API calls to the backend service.
    location /api/ {
        proxy_pass http://${BACKEND_UPSTREAM}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback: any unmatched route serves index.html so React Router can
    # take over client-side routing.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }
}
