# Copy this file to .env and adjust as needed for local docker-compose usage.

# --- PostgreSQL ---
POSTGRES_DB=takidemo
POSTGRES_USER=takidemo
POSTGRES_PASSWORD=takidemo_local_pw
POSTGRES_PORT=5432

# --- Backend (Spring Boot) ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=change-this-local-dev-secret-please-32chars-min
JWT_EXPIRATION_MS=86400000

# --- Frontend (nginx) ---
FRONTEND_PORT=80
VITE_API_BASE_URL=http://localhost:8080/api
